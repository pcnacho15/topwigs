// TOPWIGS — modelo de datos
// Prisma 6 · PostgreSQL. Incluye modelos de dominio + tablas de Better Auth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────── Dominio ───────────────

/**
 * Tipo de producto = un catálogo de la tienda (pelucas, lentes, y los que el
 * admin agregue después). Vive en la base de datos, no en el código: el slug
 * es la ruta pública (`/pelucas`) y cada tipo tiene sus propias categorías.
 */
model ProductType {
  id          String     @id @default(cuid())
  slug        String     @unique // ruta del catálogo: /<slug>
  nombre      String // singular, para formularios y textos: "Peluca"
  label       String // plural, para el nav y el título: "Pelucas"
  descripcion String     @default("")
  orden       Int        @default(0)
  activo      Boolean    @default(true)
  categories  Category[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Category {
  id            String      @id @default(cuid())
  slug          String
  nombre        String
  imagen        String? // URL de portada (Cloudinary), mostrada en Home/catálogo
  orden         Int         @default(0)
  activa        Boolean     @default(true)
  destacada     Boolean     @default(false) // el admin la elige para "Categorías destacadas" del Home
  productTypeId String
  productType   ProductType @relation(fields: [productTypeId], references: [id])
  products      Product[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // El slug solo tiene que ser único dentro de su catálogo: "fantasia" puede
  // existir a la vez en pelucas y en lentes.
  @@unique([productTypeId, slug])
  @@index([productTypeId])
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  nombre          String
  descripcion     String
  precioCop       Int
  precioOfertaCop Int? // precio con descuento (opcional). Si < precioCop → en oferta
  // El tipo de producto no se guarda aquí: lo define la categoría
  // (category.productType), así no puede desincronizarse.
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  rating          Float    @default(0)
  reviews         Int      @default(0)
  nuevo           Boolean  @default(false)
  stock           Int      @default(0) // unidades disponibles
  activo          Boolean  @default(true) // disponible para la venta (si es false o stock=0, se muestra "agotado" pero sigue visible)
  // Estructuras flexibles (se normalizan si hace falta filtrar):
  colores         Json     @default("[]") // {nombre,tipo:"solid"|"gradient",from,to}[]
  features        Json     @default("[]") // string[]
  tips            Json     @default("[]") // string[] — tips de cuidado/uso que agrega el admin
  imagenes        Json     @default("[]") // string[] (URLs Cloudinary)
  videos          Json     @default("[]") // string[] (URLs Cloudinary)
  reviewList      Review[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([categoryId])
}

/**
 * Reseña de un cliente sobre un producto. `rating`/`reviews` en `Product`
 * son un caché calculado a partir de estas filas (ver
 * `lib/reviews.ts#recomputeProductRating`), no se editan a mano.
 *
 * Un usuario tiene como máximo una reseña por producto: reenviar el
 * formulario la reemplaza (upsert) en vez de duplicarla.
 */
model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int // 1–5
  comentario String   @default("")
  imagenes   Json     @default("[]") // string[] (URLs Cloudinary) — fotos del producto que sube el cliente
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId])
}

model Order {
  id                 String   @id @default(cuid())
  reference          String   @unique
  userId             String?
  user               User?    @relation(fields: [userId], references: [id])
  customerName       String
  customerEmail      String
  customerPhone      String
  direccion          String   @default("")
  departamento       String   @default("")
  municipio          String   @default("")
  barrio             String   @default("")
  indicaciones       String?
  emailSentStatus    String? // último status para el que ya se envió correo (evita duplicados)
  items              Json // snapshot: {slug,nombre,precio,color,qty}[]
  subtotalCop        Int      @default(0) // suma de los productos, sin envío
  shippingCop        Int      @default(0) // flete (Interrápidísimo)
  ivaCop             Int      @default(0) // "IVA": comisión de Wompi (2.65%+700, +19% IVA) sobre subtotal+envío, ver lib/iva.ts
  totalCop           Int // subtotalCop + shippingCop + ivaCop; monto realmente cobrado
  status             String   @default("PENDING") // PENDING|APPROVED|DECLINED|VOIDED|ERROR
  wompiTransactionId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

/**
 * Datos de facturación / envío que el cliente eligió guardar en su cuenta
 * ("Guardar mi información") para no volver a llenar el checkout. Uno por
 * usuario: el checkout reemplaza el registro completo en cada compra.
 *
 * Los invitados guardan lo mismo en localStorage (ver
 * `lib/customer-info-storage.ts`); esta tabla es la copia que sobrevive al
 * cambio de dispositivo o de navegador.
 */
model SavedAddress {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nombre       String
  email        String
  telefono     String
  direccion    String
  departamento String
  municipio    String
  barrio       String
  indicaciones String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─────────────── Better Auth ───────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // plugin admin
  role       String?   @default("user")
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  sessions Session[]
  accounts Account[]
  orders   Order[]
  reviews  Review[]
  /// Datos de facturación guardados por el cliente (opcional, uno por usuario).
  savedAddress SavedAddress?
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String? // plugin admin

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
