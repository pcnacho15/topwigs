# ── Wompi (pasarela de pago) ──────────────────────────────────────────
# Consíguelas en https://comercios.wompi.co → Desarrolladores.
# Usa las llaves de PRUEBA (pub_test_, test_...) mientras integras.
# Copia este archivo a `.env.local` y reemplaza los valores.

# Llave pública (se usa en el Web Checkout)
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Secreto de integridad (firma el checkout — SOLO servidor, no exponer)
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxx

# Para la confirmación server-side / webhooks (siguiente fase)
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxx

# ── Base de datos (PostgreSQL) ────────────────────────────────────────
# Prisma CLI lee ESTE valor desde `.env` (no desde .env.local).
DATABASE_URL=postgresql://USUARIO:CLAVE@localhost:5432/topwigs?schema=public

# ── Better Auth ───────────────────────────────────────────────────────
# Genera un secreto: openssl rand -base64 32
BETTER_AUTH_SECRET=genera-un-secreto-aleatorio
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth (opcional) ───────────────────────────────────────────
# Google Cloud Console → Credenciales → ID de cliente OAuth.
# Redirect URI autorizado: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudinary (imágenes/videos de productos) ─────────────────────────
# Cloudinary Dashboard → Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── App ───────────────────────────────────────────────────────────────
# URL pública del sitio (Wompi redirige aquí tras el pago).
# En producción: https://tudominio.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000
